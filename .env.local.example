# =============================================================================
# Orqestra — Environment Configuration
# Copy this file to `.env.local` and fill in real values.
#
# DO NOT put real keys in this file. It is committed to git.
# Real keys belong in `.env.local`, which is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Auth + Postgres)
# Find these in your Supabase project: Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# -----------------------------------------------------------------------------
# Anthropic Claude API — required for the Run button to call Claude
# Get one at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key

# -----------------------------------------------------------------------------
# App URLs (used for OAuth + password reset redirects)
# Local: http://localhost:3000
# Production: https://your-vercel-domain.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Upstash Redis — durable rate limiting
#
# Optional in local dev (rate-limit falls back to in-memory).
# REQUIRED in production: without these, the limiter's counters reset on every
# serverless cold start and an attacker can quickly burn through Anthropic
# credits.
#
# Create a free database at: https://console.upstash.com/redis
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection on login + signup
#
# Optional. When both are set, the widget renders on the auth forms and the
# server actions verify the response token. When unset, the widget is hidden
# and verification is skipped (no-op pass-through).
#
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# RLS verification (optional — only for running scripts/rls-test.ts)
# Create two test accounts in Supabase, then export their credentials here.
# -----------------------------------------------------------------------------
# RLS_USER_A_EMAIL=
# RLS_USER_A_PASSWORD=
# RLS_USER_B_EMAIL=
# RLS_USER_B_PASSWORD=
